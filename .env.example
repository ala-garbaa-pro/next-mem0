# Copy to .env — `bun dev` and `bun scripts/*.ts` read it. All optional; see README "Configuration".

# Postgres with pgvector (the database is created if missing)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/next_mem0

# Signs session cookies. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=

# 1 = anyone can create an account on /sign-up. Off by default — use `bun run db:seed:users`.
NEXT_MEM0_ALLOW_SIGNUP=0

# Ollama embeddings
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Search hits below this cosine similarity are hidden
NEXT_MEM0_MIN_SIMILARITY=0.45

# Where the claude / codex CLIs are spawned (default: ./data/cli-workspace from source)
# NEXT_MEM0_CLI_CWD=

# Extra hosts allowed to reach the app, comma-separated, e.g. 192.168.1.*:*
# NEXT_MEM0_ALLOWED_HOSTS=
