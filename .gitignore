# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local vector db + cli workspace
/data

# e2e
/.test-data
/test-results
/playwright-report
/.tools
/.shots

# seed accounts (real credentials) — copy seed/users.json.example
/seed/users.json
